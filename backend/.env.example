# Server & Database
PORT=5000
NODE_ENV=production
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret_key

# Platform Public URL (Your Railway deployment URL without trailing slash)
URL=https://cartsy-prod.up.railway.app

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google Sign-In (Frontend Customer Authentication)
GOOGLE_CLIENT_ID=your_google_signin_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_signin_client_secret

# Email Provider ('gmail_api' for development/Render without domain, 'nodemailer' for custom SMTP)
EMAIL_PROVIDER=gmail_api

# Gmail API (Dedicated OAuth 2.0 Client for Sending Server Emails)
GMAIL_CLIENT_ID=your_gmail_mailer_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_mailer_client_secret
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
GMAIL_REFRESH_TOKEN=your_oauth_refresh_token
GMAIL_FROM_NAME=Cartsy
GMAIL_FROM_EMAIL=your_email@gmail.com

# Nodemailer / SMTP (Preserved for future custom domain setup)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Cartsy <your_email@gmail.com>"

# Discord Webhooks (Optional)
DISCORD_STOCK_WEBHOOK_URL=
DISCORD_ORDER_WEBHOOK_URL=
DISCORD_CONTACT_WEBHOOK_URL=